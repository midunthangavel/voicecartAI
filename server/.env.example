# ============================================
# VoiceCart AI — Environment Configuration
# ============================================

# ─── AI Provider Configuration ───
# Switch between cloud providers without code changes
AI_LLM_PROVIDER=gemini              # groq | gemini | openrouter
AI_STT_PROVIDER=mock                # groq | google | mock
AI_TTS_PROVIDER=mock                # sarvam | google | mock

# ─── Gemini (Google AI Studio — Free Tier) ───
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Groq (Free: Llama 3.3 70B + Whisper Large v3) ───
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# ─── OpenRouter (Free fallback models) ───
# Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# ─── Sarvam AI (Premium Tamil TTS) ───
# Get key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_key_here

# ─── Google Cloud (STT & TTS) ───
# Path to your GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# ─── Twilio (Telephony + SMS) ───
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# ─── Razorpay (Payment Links) ───
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── Server & Telephony ───
PORT=3001
HOST=0.0.0.0
PUBLIC_URL=https://your-ngrok-or-domain.com
LOG_LEVEL=info

# ─── Database & Storage ───
DB_PATH=./voicecart.db
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_BUCKET=voicecart-recordings

# ─── Prompt & Dispatch Control ───
AI_PROMPT_VERSION=v2                # v1 | v2
DISPATCH_MODE=direct                # direct | ondc

